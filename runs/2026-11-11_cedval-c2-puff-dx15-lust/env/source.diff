+					if(P1[j].p_type!=1)      continue;     // fluid only
+					Real xj=P1[j].x;
+					if(xj>=xi) continue;                   // upstream of buffer
+					Real yj=P1[j].y, zj=P1[j].z;
+					Real tdist=sqrt((xi-xj)*(xi-xj)+(yi-yj)*(yi-yj)+(zi-zj)*(zi-zj));
